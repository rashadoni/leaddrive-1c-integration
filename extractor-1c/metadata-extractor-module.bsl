// ============================================================================
// МетаданныеВыгрузка — модуль формы внешней обработки (1С 8.2, обычные формы)
// Назначение: выгрузка карты метаданных в текстовый файл (UTF-8).
// Данные НЕ читаются — только структура конфигурации.
// Формат строк: #TAG|поле1|поле2|... (TSV-подобный, разделитель "|")
// ============================================================================

Процедура КнопкаВыполнитьНажатие(Кнопка)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда сохранить выгрузку метаданных";
	Диалог.Фильтр    = "Текстовый файл (*.txt)|*.txt";
	Если НЕ Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = Диалог.ПолноеИмяФайла;
	Текст = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);

	Текст.ЗаписатьСтроку("#HEADER|version=1|date=" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	Текст.ЗаписатьСтроку("#CONFIG|" + Экр(Метаданные.Имя) + "|" + Экр(Метаданные.Синоним) + "|" + Экр(Метаданные.Версия));

	// ---------- Часть 1: структура хранения СУБД (если метод доступен) ----------
	Попытка
		// Второй параметр Истина = вернуть имена таблиц/полей СУБД (_Document123/_Fld456)
		Структура = ПолучитьСтруктуруХраненияБазыДанных(, Истина);
		Для Каждого СтрТаб Из Структура Цикл
			Текст.ЗаписатьСтроку("#TABLE|" + Экр(СтрТаб.ИмяТаблицыХранения)
				+ "|" + Экр(СтрТаб.ИмяТаблицы)
				+ "|" + Экр(СтрТаб.Метаданные)
				+ "|" + Экр(СтрТаб.Назначение));
			Попытка
				Для Каждого СтрПоле Из СтрТаб.Поля Цикл
					Текст.ЗаписатьСтроку("#FIELD|" + Экр(СтрТаб.ИмяТаблицыХранения)
						+ "|" + Экр(СтрПоле.ИмяПоляХранения)
						+ "|" + Экр(СтрПоле.ИмяПоля)
						+ "|" + Экр(СтрПоле.Метаданные));
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
		Текст.ЗаписатьСтроку("#STORAGE_STRUCTURE|UNAVAILABLE|" + Экр(ОписаниеОшибки()));
	КонецПопытки;

	// ---------- Часть 2: дерево метаданных (всегда) ----------
	ВыгрузитьКоллекцию(Текст, "Document",  Метаданные.Документы);
	ВыгрузитьКоллекцию(Текст, "Reference", Метаданные.Справочники);
	ВыгрузитьКоллекцию(Текст, "AccumRg",   Метаданные.РегистрыНакопления);
	ВыгрузитьКоллекцию(Текст, "InfoRg",    Метаданные.РегистрыСведений);
	ВыгрузитьКоллекцию(Текст, "AccRg",     Метаданные.РегистрыБухгалтерии);
	ВыгрузитьКоллекцию(Текст, "Enum",      Метаданные.Перечисления);

	Текст.Закрыть();
	Предупреждение("Готово. Файл: " + ПутьКФайлу, 30);

КонецПроцедуры

Процедура ВыгрузитьКоллекцию(Текст, Вид, Коллекция)

	Для Каждого Объект Из Коллекция Цикл

		УИД = "";
		Попытка
			// На части сборок 8.2 свойство может отсутствовать — не критично:
			// сопоставление тогда делается через DBNames-декодер + эвристику.
			УИД = Строка(Объект.УникальныйИдентификатор);
		Исключение
		КонецПопытки;

		Текст.ЗаписатьСтроку("#META|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(Объект.Синоним) + "|" + УИД);

		// Реквизиты (документы, справочники)
		Попытка
			Для Каждого Р Из Объект.Реквизиты Цикл
				Текст.ЗаписатьСтроку("#ATTR|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(Р.Имя) + "|" + Экр(Р.Синоним));
			КонецЦикла;
		Исключение
		КонецПопытки;

		// Табличные части
		Попытка
			Для Каждого ТЧ Из Объект.ТабличныеЧасти Цикл
				Текст.ЗаписатьСтроку("#TABSECTION|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(ТЧ.Имя) + "|" + Экр(ТЧ.Синоним));
				Для Каждого РТ Из ТЧ.Реквизиты Цикл
					Текст.ЗаписатьСтроку("#TSATTR|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(ТЧ.Имя) + "|" + Экр(РТ.Имя) + "|" + Экр(РТ.Синоним));
				КонецЦикла;
			КонецЦикла;
		Исключение
		КонецПопытки;

		// Измерения / ресурсы / реквизиты регистров
		Попытка
			Для Каждого Изм Из Объект.Измерения Цикл
				Текст.ЗаписатьСтроку("#DIM|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(Изм.Имя) + "|" + Экр(Изм.Синоним));
			КонецЦикла;
			Для Каждого Рес Из Объект.Ресурсы Цикл
				Текст.ЗаписатьСтроку("#RES|" + Вид + "|" + Экр(Объект.Имя) + "|" + Экр(Рес.Имя) + "|" + Экр(Рес.Синоним));
			КонецЦикла;
		Исключение
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Экранирование разделителя и переводов строк в значениях
Функция Экр(Значение)
	С = Строка(Значение);
	С = СтрЗаменить(С, "|", "/");
	С = СтрЗаменить(С, Символы.ПС, " ");
	С = СтрЗаменить(С, Символы.ВК, " ");
	Возврат С;
КонецФункции
